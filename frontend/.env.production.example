# Bobcat frontend production environment.
#
# In local dev (npm run dev) you can leave this alone - apiClient.js falls
# back to http://localhost:5000 when VITE_BACKEND_URL is unset.
#
# For Netlify, paste this single variable into:
#   Site settings -> Build & deploy -> Environment -> Environment variables
#
# DO NOT commit the real file with a secret URL - copy this to .env.production
# locally only if you want to test the production build against your backend.

VITE_BACKEND_URL=https://your-backend.up.railway.app
